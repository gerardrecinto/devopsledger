# DevOpsLedger - environment variable reference
# Copy to .env and edit before running.
# Never commit .env.

# PostgreSQL
POSTGRES_USER=devopsledger
POSTGRES_PASSWORD=changeme
POSTGRES_DB=devopsledger

# API
DATABASE_URL=postgresql://devopsledger:changeme@postgres:5432/devopsledger
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
ENVIRONMENT=development
ENABLE_DOCS=true
OFFLINE_MODE=true
TELEMETRY_ENABLED=false
# Optional YAML file mounted into the API container for rules-based risk scoring.
# RISK_RULES_PATH=/config/risk-rules.yaml

# Web
API_URL=http://api:8000

# Integrations - all disabled by default
# Uncomment and set values to enable each integration.
# GITHUB_TOKEN=
# TERRAFORM_CLOUD_TOKEN=
# PAGERDUTY_API_KEY=
# JIRA_URL=
# JIRA_TOKEN=
# SERVICENOW_URL=
# SERVICENOW_TOKEN=
